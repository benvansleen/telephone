import "go:path/filepath"

import "callgraph"
import "source"
import "treesitter"

pub fn analyze_dir(root: string) -> Result<callgraph.Graph, error> {
  analyze_files(source.files(root)?)
}

pub fn analyze_files(files: Slice<source.File>) -> Result<callgraph.Graph, error> {
  let adapter = Lisette.new()
  let extracted = treesitter.extract_files(adapter, files)
  Ok(resolve(extracted))
}

pub fn resolve(files: Slice<treesitter.ExtractedFile>) -> callgraph.Graph {
  let mut declarations = callgraph.Symbols.new()
  let mut functions: Map<string, callgraph.Symbol> = Map.new()
  let mut methods: Map<string, Option<callgraph.Symbol>> = Map.new()

  for file in files {
    let package = package_of(file.path)
    for name in file.declarations {
      let symbol = callgraph.Symbol.local(file.path, name)
      declarations.push(symbol)
      if name.contains(".") {
        let method = field_name(name)
        let key = f"{package}.{method}"
        match methods.get(key) {
          Some(_) => methods[key] = None,
          None => methods[key] = Some(symbol),
        }
      } else {
        functions[f"{package}.{name}"] = symbol
      }
    }
  }

  let mut edges: Slice<callgraph.Edge> = Slice.new()
  for file in files {
    for call in file.calls {
      let callee = resolve_call(call, file, functions, methods)
      let kind = match callee.location {
        callgraph.SymbolLocation.External => "external",
        callgraph.SymbolLocation.File { .. } => "local",
      }
      edges = edges.append(
        callgraph.Edge {
          caller: callgraph.Symbol.local(file.path, call.caller),
          callee,
          kind,
        },
      )
    }
  }
  callgraph.Graph { decls: declarations, edges }
}

fn resolve_call(
  call: treesitter.ExtractedCall,
  file: treesitter.ExtractedFile,
  functions: Map<string, callgraph.Symbol>,
  methods: Map<string, Option<callgraph.Symbol>>,
) -> callgraph.Symbol {
  let package = package_of(file.path)
  if !call.callee.contains(".") {
    return functions
      .get(f"{package}.{call.callee}")
      .unwrap_or_else(|| {
        callgraph.Symbol.external(call.callee)
      })
  }

  let parts = call.callee.split(".")
  let first = parts[0]
  let method = field_name(call.callee)
  if first == "self" && call.caller.contains(".") {
    let receiver = call.caller.split(".")[0]
    return method_for(package, receiver, method, methods, call.callee)
  }
  for imported in file.imports {
    if imported.alias == first || (import_name(imported.path) == first &&
    imported.alias == "") {
      if imported.is_go { return callgraph.Symbol.external(call.callee) }
      return functions
        .get(f"{imported.path}.{method}")
        .unwrap_or_else(|| {
          callgraph.Symbol.external(call.callee)
        })
    }
  }
  method_for(package, first, method, methods, call.callee)
}

fn method_for(
  package: string,
  receiver: string,
  method: string,
  methods: Map<string, Option<callgraph.Symbol>>,
  fallback: string,
) -> callgraph.Symbol {
  match methods.get(f"{package}.{receiver}.{method}") {
    Some(Some(symbol)) => symbol,
    _ => methods
      .get(f"{package}.{method}")
      .unwrap_or(None)
      .unwrap_or_else(|| callgraph.Symbol.external(fallback)),
  }
}

fn package_of(path: string) -> string {
  let package = filepath.Dir(path)
  if package == "." { "" } else { package }
}

fn import_name(path: string) -> string {
  let parts = path.split("/")
  parts[parts.length() - 1]
}

fn field_name(qualified: string) -> string {
  let parts = qualified.split(".")
  parts[parts.length() - 1]
}
