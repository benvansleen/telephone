import "go:github.com/telephone/ts-shim"
import "go:github.com/telephone/tsgrammar"
import ts "go:github.com/tree-sitter/go-tree-sitter"

import "treesitter"

pub struct Lisette {}

pub struct LisetteWorker {
  ready: bool,
  parser: Ref<ts.Parser>,
  cursor: Ref<ts.QueryCursor>,
  query: Option<Ref<ts.Query>>,
}

impl Lisette {
  pub fn new() -> Lisette {
    Lisette {}
  }

  pub fn supports(self, path: string) -> bool {
    path.ends_with(".lis")
  }

  pub fn worker(self) -> treesitter.Worker {
    LisetteWorker.new()
  }

  pub fn adapter(self) -> treesitter.Adapter {
    self
  }

  pub fn extract(self, path: string, source: Slice<byte>) -> treesitter.ExtractedFile {
    let worker = LisetteWorker.new()
    defer worker.close()
    worker.extract(path, source)
  }
}

impl LisetteWorker {
  fn new() -> LisetteWorker {
    let parser = ts.NewParser()
    let language = ts.NewLanguage(tsgrammar.LisetteLanguage())
    let ready = parser.SetLanguage(language).is_ok()
    let compiled = if ready {
      treesitter.compile(language, extraction_query()).ok()
    } else {
      None
    }
    LisetteWorker {
      ready,
      parser,
      cursor: ts.NewQueryCursor(),
      query: compiled,
    }
  }

  pub fn extract(self, path: string, source: Slice<byte>) -> treesitter.ExtractedFile {
    if !self.ready { return empty_file(path) }
    self.parser.Reset()
    let Some(tree) = self.parser.Parse(source, tsshim.NewEmptyTree()) else {
      return empty_file(path)
    }
    defer tree.Close()

    let mut declarations: Slice<string> = Slice.new()
    let mut declaration_names: Map<string, bool> = Map.new()
    let mut callers: Map<uintptr, string> = Map.new()
    let mut pending_calls: Slice<treesitter.ExtractedCall> = Slice.new()
    let mut imports: Slice<treesitter.ExtractedImport> = Slice.new()
    if let Some(query) = self.query {
      treesitter.for_each_match_with_cursor(
        self.cursor,
        query,
        tree.RootNode(),
        source,
        |group| {
          let mut alias = ""
          let mut import_path = ""
          for hit in group {
            let mut node = hit.node
            match hit.name {
              "name" => {
                let name = node.Utf8Text(source)
                let declaration = declaration_of(node)
                let identity = impl_type(declaration, source).map_or(
                  name,
                  |type_name| f"{type_name}.{name}",
                )
                if declaration_names.get(identity).is_none() {
                  declaration_names[identity] = true
                  declarations = declarations.append(identity)
                }
                if let Some(declaration) = declaration {
                  callers[declaration.Id()] = identity
                }
              },
              "callee" => pending_calls = pending_calls.append(
                treesitter.ExtractedCall {
                  caller: caller_of(node, source, callers),
                  callee: callee_identity(node, source),
                  kind: "unresolved",
                },
              ),
              "alias" => alias = node.Utf8Text(source),
              "path" => import_path = unquote(node.Utf8Text(source)),
              _ => (),
            }
          }
          if import_path != "" {
            imports = imports.append(
              treesitter.ExtractedImport {
                alias,
                path: import_path,
                is_go: import_path.starts_with("go:"),
              },
            )
          }
        },
      )
    }

    let mut calls: Slice<treesitter.ExtractedCall> = Slice.new()
    let mut seen: Map<string, bool> = Map.new()
    for call in pending_calls {
      let key = f"{call.caller}|{call.callee}"
      if seen.get(key).is_some() { continue }
      seen[key] = true
      calls = calls.append(call)
    }
    treesitter.ExtractedFile { path, declarations, calls, imports }
  }

  pub fn close(self) {
    if let Some(query) = self.query { query.Close() }
    self.cursor.Close()
    self.parser.Close()
  }
}

fn empty_file(path: string) -> treesitter.ExtractedFile {
  treesitter.ExtractedFile {
    path,
    declarations: Slice.new(),
    calls: Slice.new(),
    imports: Slice.new(),
  }
}

fn extraction_query() -> string {
  "[
  (function_item name: (identifier) @name)
  (call_expression function: (_) @callee)
  (generic_call_expression function: (_) @callee)
  (binary_expression operator: \"|>\" right: (identifier) @callee)
  (binary_expression operator: \"|>\" right: (field_expression) @callee)
  (import_declaration
    alias: (identifier)? @alias
    path: (string_literal) @path)
]"
}

fn callee_identity(mut node: ts.Node, source: Slice<byte>) -> string {
  if node.Kind() != "field_expression" { return node.Utf8Text(source) }
  let Some(value) = node.ChildByFieldName("value") else {
    return node.Utf8Text(source)
  }
  let Some(field) = node.ChildByFieldName("field") else {
    return node.Utf8Text(source)
  }
  let receiver = if value.Kind() == "call_expression" {
    value
      .ChildByFieldName("function")
      .map_or("", |function| if function.Kind() == "field_expression" {
        function
          .ChildByFieldName("value")
          .map_or("", |root| callee_identity(root.*, source))
      } else {
        callee_identity(function.*, source)
      })
  } else {
    callee_identity(value.*, source)
  }
  if receiver == "" {
    field.Utf8Text(source)
  } else {
    f"{receiver}.{field.Utf8Text(source)}"
  }
}

fn caller_of(
  start: ts.Node,
  source: Slice<byte>,
  mut callers: Map<uintptr, string>,
) -> string {
  let declaration = declaration_of(start)
  let Some(declaration) = declaration else {
    return "<global>"
  }
  let key = declaration.Id()
  if let Some(caller) = callers.get(key) { return caller }
  let name = declaration
    .ChildByFieldName("name")
    .map_or("", |node| node.Utf8Text(source))
  let caller = impl_type(Some(declaration), source).map_or(
    name,
    |type_name| f"{type_name}.{name}",
  )
  callers[key] = caller
  caller
}

fn declaration_of(start: ts.Node) -> Option<Ref<ts.Node>> {
  let mut node = start
  let mut current = node.Parent()
  loop {
    let Some(parent) = current else {
      return None
    }
    if parent.Kind() == "function_item" { return Some(parent) }
    current = parent.Parent()
  }
}

fn impl_type(start: Option<Ref<ts.Node>>, source: Slice<byte>) -> Option<string> {
  let Some(start) = start else {
    return None
  }
  let node = start
  let mut current = node.Parent()
  loop {
    let Some(parent) = current else {
      return None
    }
    if parent.Kind() == "impl_item" {
      return parent
        .ChildByFieldName("type")
        .map(|type_node| {
          base_type(type_node.Utf8Text(source))
        })
    }
    current = parent.Parent()
  }
}

fn base_type(type_name: string) -> string {
  type_name.split("<")[0]
}

fn unquote(text: string) -> string {
  text.substring(1..text.length() - 1)
}
