import "go:os"
import "go:path/filepath"
import "go:slices"
import "go:strings"

import "callgraph"
import "treesitter"

fn analyze(source: Slice<byte>) -> callgraph.Graph {
  resolve([Go.new().extract("test.go", source)])
}

fn analyze_dir(root: string) -> Result<callgraph.Graph, error> {
  treesitter.analyze_dir(Go.new(), root)
}

fn analyze_dir_with(root: string, _: string, _: string) -> Result<callgraph.Graph, error> {
  analyze_dir(root)
}

fn supports_go_files(adapter: treesitter.Adapter) -> bool {
  adapter.supports("main.go")
}

#[test]
fn implements_treesitter_adapter() {
  assert supports_go_files(Go.new())
}

#[test]
fn implements_treesitter_language() {
  let language: treesitter.Language = Go.new()
  assert language.adapter().supports("main.go")
  assert language.resolve(Slice.new()).decls.count() == 0
}

fn render_graph(graph: callgraph.Graph) -> string {
  let mut lines = graph.decls.reduce(Slice.new(), |acc, d| {
    acc.append(f"def {d.display_key()}")
  })
  for e in graph.edges {
    lines = lines.append(
      f"edge {e.caller.display_key()} -> {e.callee.display_key()} ({e.kind})",
    )
  }
  slices.Sort(lines)
  strings.Join(lines, "\n")
}

fn diff_edges(a: callgraph.Graph, b: callgraph.Graph) -> string {
  let mut out: Slice<string> = Slice.new()
  let a_lines = render_graph(a).split("\n")
  let b_lines = render_graph(b).split("\n")
  for line in a_lines {
    if !b_lines.contains(line) { out = out.append(f"- {line}") }
  }
  for line in b_lines {
    if !a_lines.contains(line) { out = out.append(f"+ {line}") }
  }
  slices.Sort(out)
  strings.Join(out, "\n")
}

#[test]
fn local_edges_and_dedup() {
  let source = "package example
func Foo() {
  Bar()
  Bar()
}

func Bar() {}
"
  let graph = analyze(source.bytes())
  assert has_decl(graph.decls, "Foo")
  assert has_decl(graph.decls, "Bar")
  assert graph.edges.length() == 1
  assert graph.edges[0].caller.name == "Foo"
  assert graph.edges[0].callee.name == "Bar"
  assert graph.edges[0].kind == "local"
}

#[test]
fn external_calls_are_tagged() {
  let source = "package example
import \"fmt\"

func Foo() {
  fmt.Println(\"hi\")
}
"
  let graph = analyze(source.bytes())
  assert graph.edges.length() == 1
  assert graph.edges[0].caller.name == "Foo"
  assert graph.edges[0].callee.name == "fmt.Println"
  assert graph.edges[0].kind == "external"
}

fn has_decl(decls: callgraph.Symbols, name: string) -> bool {
  decls.find(|d| d.name == name).is_some()
}

fn has_edge(
  edges: Slice<callgraph.Edge>,
  caller: string,
  callee: string,
  kind: string,
) -> bool {
  for e in edges {
    let caller_matches = if caller.contains(":") {
      e.caller.display_key() == caller
    } else {
      e.caller.name == caller
    }
    let callee_matches = if callee.contains(":") {
      e.callee.display_key() == callee
    } else {
      e.callee.name == callee
    }
    if caller_matches && callee_matches && e.kind == kind { return true }
  }
  false
}

#[test]
fn pending_and_external_symbols_have_distinct_identities() {
  let local = callgraph.Symbol.local("cmd:tool/main.go", "Run")
  let external = callgraph.Symbol.external("Run")
  assert local.to_key() != external.to_key()
  assert local.display_key() == "cmd:tool/main.go:Run"
  assert external.display_key() == "Run"
}

#[test]
fn method_calls_resolve_to_receiver_type() {
  let source = "package example

type Counter struct { n int }

func (c Counter) Inc() {}

func (c *Counter) Reset() {}

func Use() {
  var c Counter
  c.Inc()
  c.Reset()
}
"
  let graph = analyze(source.bytes())
  assert has_decl(graph.decls, "Counter.Inc")
  assert has_decl(graph.decls, "Counter.Reset")
  assert has_edge(graph.edges, "Use", "Counter.Inc", "method")
  assert has_edge(graph.edges, "Use", "Counter.Reset", "method")
}

#[test]
fn calls_inside_anonymous_functions_attribute_to_enclosing_fn() {
  let source = "package example

func Foo() {
  task { Bar() }
}

func Bar() {}
"
  let graph = analyze(source.bytes())
  assert graph.edges.length() == 1
  assert graph.edges[0].caller.name == "Foo"
  assert graph.edges[0].callee.name == "Bar"
}

#[test]
fn render_produces_sorted_lines() {
  let source = "package example

func Foo() { Bar() }

func Bar() {}
"
  let graph = analyze(source.bytes())
  let out = render_graph(graph)
  let lines = out.split("\n")
  assert lines[0] == "def test.go:Bar"
  assert lines[1] == "def test.go:Foo"
  assert lines[2] == "edge test.go:Foo -> test.go:Bar (local)"
}

#[test]
fn diff_reports_added_and_removed_edges() {
  let a = analyze("package x\nfunc Foo() { fmt.Println() }\n".bytes())
  let b = analyze("package x\nfunc Foo() { Bar() }\nfunc Bar() {}\n".bytes())
  let out = diff_edges(a, b)
  assert out.contains("- edge test.go:Foo -> fmt.Println (external)")
  assert out.contains("+ def test.go:Bar")
  assert out.contains("+ edge test.go:Foo -> test.go:Bar (local)")
}

fn std_dq() -> string {
  "[
  (function_declaration name: (identifier) @fn.name) @fn.decl
  (method_declaration
    receiver: (parameter_list
      (parameter_declaration
        type: (_) @method.receiver))
    name: (field_identifier) @method.name) @method.decl
]"
}

fn std_cq() -> string {
  "(call_expression function: (_) @callee)"
}

fn write_proj(dir: string, files: Slice<(string, string)>) {
  for (name, content) in files {
    let _ = os.WriteFile(filepath.Join(dir, name), content.bytes(), 0o644)
  }
}

#[test]
fn cross_file_local_and_method_resolution() {
  let dir = os.MkdirTemp("", "callgraph-*").unwrap_or("/tmp/callgraph")
  write_proj(dir, [
    (
      "a.go",
      "package app

type DB struct{}

func Run() {
  helper()
  d := DB{}
  d.Query()
}
",
    ),
    (
      "b.go",
      "package app

func helper() {}

func (d *DB) Query() {
  helper()
}
",
    ),
  ])
  let Ok(graph) = analyze_dir_with(dir, std_dq(), std_cq()) else {
    let _ = os.RemoveAll(dir)
    assert false
    return
  }
  let _ = os.RemoveAll(dir)
  assert has_edge(graph.edges, "a.go:Run", "b.go:helper", "local")
  assert has_edge(graph.edges, "a.go:Run", "b.go:DB.Query", "method")
  assert has_edge(graph.edges, "b.go:DB.Query", "b.go:helper", "local")
}

#[test]
fn ambiguous_method_stays_external() {
  let dir = os.MkdirTemp("", "callgraph-*").unwrap_or("/tmp/callgraph")
  write_proj(dir, [
    (
      "a.go",
      "package app

func Run() {
  x.Save()
}
",
    ),
    (
      "b.go",
      "package app

type A struct{}
type B struct{}

func (a A) Save() {}
func (b B) Save() {}
",
    ),
  ])
  let Ok(graph) = analyze_dir_with(dir, std_dq(), std_cq()) else {
    let _ = os.RemoveAll(dir)
    assert false
    return
  }
  let _ = os.RemoveAll(dir)
  assert has_edge(graph.edges, "a.go:Run", "x.Save", "external")
}

fn test_root() -> string {
  filepath.Dir(filepath.Dir(filepath.Dir(os.Getwd().unwrap_or("."))))
}

#[test]
fn render_tree_shows_direct_calls_only() {
  let dir = os.MkdirTemp("", "callgraph-*").unwrap_or("/tmp/callgraph")
  write_proj(dir, [
    (
      "a.go",
      "package app

func Boot() {
  worker()
}
",
    ),
    (
      "b.go",
      "package app

func worker() {
  fmt.Println()
}
",
    ),
  ])
  let Ok(graph) = analyze_dir_with(dir, std_dq(), std_cq()) else {
    let _ = os.RemoveAll(dir)
    assert false
    return
  }
  let _ = os.RemoveAll(dir)
  let out = graph.render_tree()
  assert out ==
  "a.go:\n  Boot\n    - worker (b.go)\nb.go:\n  worker\n    - fmt.Println (external)"
}

#[test]
fn render_tree_indents_fluent_call_continuations() {
  let graph = callgraph.Graph {
    decls: callgraph.Symbols.from([callgraph.Symbol.local("a.go", "Run")]),
    edges: [
      callgraph.Edge {
        caller: callgraph.Symbol.local("a.go", "Run"),
        callee: callgraph.Symbol.external("symbols\n.find"),
        kind: "external",
      },
    ],
  }
  assert graph.render_tree() ==
  "a.go:\n  Run\n    - symbols\n        .find (external)"
}

#[test]
fn diff_trees_reports_added_removed_fns_and_calls() {
  let dir_a = os.MkdirTemp("", "callgraph-*").unwrap_or("/tmp/callgraph")
  write_proj(dir_a, [
    (
      "a.go",
      "package app

func Boot() {
  stableWork()
  oldWork()
}
",
    ),
    (
      "b.go",
      "package app

func oldWork() { stableWork() }

func stableWork() {}
",
    ),
  ])
  let dir_b = os.MkdirTemp("", "callgraph-*").unwrap_or("/tmp/callgraph")
  write_proj(dir_b, [
    (
      "a.go",
      "package app

func Boot() {
  stableWork()
  newWork()
}
",
    ),
    (
      "b.go",
      "package app

func newWork() { stableWork() }

func stableWork() {}
",
    ),
  ])
  let Ok(ga) = analyze_dir_with(dir_a, std_dq(), std_cq()) else {
    let _ = os.RemoveAll(dir_a)
    let _ = os.RemoveAll(dir_b)
    assert false
    return
  }
  let Ok(gb) = analyze_dir_with(dir_b, std_dq(), std_cq()) else {
    let _ = os.RemoveAll(dir_a)
    let _ = os.RemoveAll(dir_b)
    assert false
    return
  }
  let _ = os.RemoveAll(dir_a)
  let _ = os.RemoveAll(dir_b)
  let out = ga.diff_trees(gb)
  assert out ==
  "a.go:\n  Boot\n      stableWork (b.go)\n    - oldWork (b.go)\n    + newWork (b.go)\nb.go:\n  - oldWork\n      stableWork\n  + newWork\n      stableWork"
  assert ga.diff_trees_ansi(gb) ==
  "\x1b[1;36ma.go:\x1b[0m\n\x1b[1m  Boot\x1b[0m\n      stableWork \x1b[2;3m(b.go)\x1b[0m\n\x1b[38;5;210;48;2;54;29;32m    - oldWork \x1b[2;3;38;5;210;48;2;54;29;32m(b.go)\x1b[0m\n\x1b[38;5;114;48;2;25;43;34m    + newWork \x1b[2;3;38;5;114;48;2;25;43;34m(b.go)\x1b[0m\n\x1b[1;36mb.go:\x1b[0m\n\x1b[38;5;210;48;2;54;29;32m  - oldWork\x1b[0m\n      stableWork\n\x1b[38;5;114;48;2;25;43;34m  + newWork\x1b[0m\n      stableWork"
}

#[test]
fn commit_fixture_reports_cross_file_call_changes() {
  let root = test_root()
  let before = filepath.Join(root, "testdata", "commits", "before")
  let after = filepath.Join(root, "testdata", "commits", "after")
  let Ok(old_graph) = analyze_dir(before) else {
    assert false
    return
  }
  let Ok(new_graph) = analyze_dir(after) else {
    assert false
    return
  }
  assert old_graph.diff_trees(new_graph) ==
  "audit.go:
  - logAudit
  + recordAccess
auth.go:
  authenticate
    - legacySession (session.go)
    + verifyToken (token.go)
dashboard.go:
  renderDashboard
    - logAudit (audit.go)
    + recordAccess (audit.go)
preferences.go:
  + hydratePreferences
profile.go:
  loadProfile
    + hydratePreferences (preferences.go)
session.go:
  - legacySession
token.go:
  + verifyToken"
}

#[test]
fn testdata_project_graph() {
  let root = test_root()
  let dq = os
    .ReadFile(filepath.Join(root, "queries", "decls.scm"))
    .ok()
    .unwrap_or_else(|| Slice.new())
  let cq = os
    .ReadFile(filepath.Join(root, "queries", "calls.scm"))
    .ok()
    .unwrap_or_else(|| Slice.new())
  let case = filepath.Join(root, "testdata")
  match analyze_dir_with(case, dq as string, cq as string) {
    Ok(graph) => {
      assert has_edge(
        graph.edges,
        "app/app.go:Boot",
        "app/workers.go:worker",
        "local",
      )
      assert has_edge(
        graph.edges,
        "app/app.go:Boot",
        "app/app.go:Server.Start",
        "method",
      )
      assert has_edge(
        graph.edges,
        "app/handlers.go:Handler.Run",
        "app/store.go:DB.Query",
        "method",
      )
      assert has_edge(graph.edges, "main.go:main", "app.Boot", "external")
    },
    Err(err) => {
      assert f"analyze_dir failed with: {err.Error()}" == "ok"
    },
  }
}
