import "go:github.com/telephone/ts-shim"
import ts "go:github.com/tree-sitter/go-tree-sitter"
import tsgo "go:github.com/telephone/tsgrammar"

import "treesitter"

pub struct Go {}

pub struct GoWorker {
  ready: bool,
  parser: Ref<ts.Parser>,
  cursor: Ref<ts.QueryCursor>,
  query: Option<Ref<ts.Query>>,
}

impl Go {
  pub fn new() -> Go {
    Go {}
  }

  pub fn supports(self, path: string) -> bool {
    path.ends_with(".go")
  }

  pub fn worker(self) -> treesitter.Worker {
    GoWorker.new()
  }

  pub fn extract(self, path: string, source: Slice<byte>) -> treesitter.ExtractedFile {
    let worker = GoWorker.new()
    defer worker.close()
    worker.extract(path, source)
  }
}

impl GoWorker {
  fn new() -> GoWorker {
    let parser = ts.NewParser()
    let language = ts.NewLanguage(tsgo.GoLanguage())
    let ready = parser.SetLanguage(language).is_ok()
    let compiled = if ready {
      treesitter.compile(language, extraction_query()).ok()
    } else {
      None
    }
    GoWorker { ready, parser, cursor: ts.NewQueryCursor(), query: compiled }
  }

  pub fn extract(self, path: string, source: Slice<byte>) -> treesitter.ExtractedFile {
    if !self.ready { return empty_file(path) }
    self.parser.Reset()
    let Some(tree) = self.parser.Parse(source, tsshim.NewEmptyTree()) else {
      return empty_file(path)
    }
    defer tree.Close()

    let mut declarations: Slice<string> = Slice.new()
    let mut declaration_names: Map<string, bool> = Map.new()
    let mut callers: Map<uintptr, string> = Map.new()
    let mut pending_calls: Slice<treesitter.ExtractedCall> = Slice.new()
    if let Some(query) = self.query {
      treesitter.for_each_match_with_cursor(
        self.cursor,
        query,
        tree.RootNode(),
        source,
        |group| {
          let mut name = None
          let mut receiver = None
          let mut declaration = None
          for hit in group {
            let mut node = hit.node
            match hit.name {
              "fn.name" | "method.name" => {
                name = Some(node.Utf8Text(source))
                declaration = declaration_of(node)
              },
              "method.receiver" => receiver = Some(trim_pointer(node.Utf8Text(
                source,
              ))),
              "callee" => pending_calls = pending_calls.append(
                treesitter.ExtractedCall {
                  caller: caller_of(node, source, callers),
                  callee: node.Utf8Text(source),
                  kind: node.Kind(),
                },
              ),
              _ => (),
            }
          }
          if let Some(name) = name {
            let name = receiver.map_or(
              name,
              |receiver_name| f"{receiver_name}.{name}",
            )
            if declaration_names.get(name).is_none() {
              declaration_names[name] = true
              declarations = declarations.append(name)
            }
            if let Some(declaration) = declaration {
              callers[declaration.Id()] = name
            }
          }
        },
      )
    }

    let mut calls = Slice.new()
    let mut seen = Map.new()
    for call in pending_calls {
      let kind = if call.kind == "identifier" && declaration_names
        .get(call.callee)
        .is_some() {
        "local"
      } else {
        "unresolved"
      }
      let key = f"{call.caller}|{kind}|{call.callee}"
      if seen.get(key).is_some() { continue }
      seen[key] = true
      calls = calls.append(
        treesitter.ExtractedCall {
          caller: call.caller,
          callee: call.callee,
          kind,
        },
      )
    }
    treesitter.ExtractedFile { path, declarations, calls, imports: Slice.new() }
  }

  pub fn close(self) {
    if let Some(query) = self.query { query.Close() }
    self.cursor.Close()
    self.parser.Close()
  }
}

fn empty_file(path: string) -> treesitter.ExtractedFile {
  treesitter.ExtractedFile {
    path,
    declarations: Slice.new(),
    calls: Slice.new(),
    imports: Slice.new(),
  }
}

fn extraction_query() -> string {
  "[
  (function_declaration name: (identifier) @fn.name)
  (method_declaration
    receiver: (parameter_list
      (parameter_declaration type: (_) @method.receiver))
    name: (field_identifier) @method.name)
  (call_expression function: (_) @callee)
]"
}

fn caller_of(
  start: ts.Node,
  source: Slice<byte>,
  mut callers: Map<uintptr, string>,
) -> string {
  let Some(declaration) = declaration_of(start) else {
    return "<global>"
  }
  let key = declaration.Id()
  if let Some(caller) = callers.get(key) { return caller }
  let caller = match declaration.Kind() {
    "function_declaration" => fn_name(declaration, source),
    "method_declaration" => method_identity(declaration, source),
    _ => "<global>",
  }
  callers[key] = caller
  caller
}

fn declaration_of(start: ts.Node) -> Option<Ref<ts.Node>> {
  let mut node = start
  let mut current = node.Parent()
  loop {
    let Some(parent) = current else {
      return None
    }
    match parent.Kind() {
      "function_declaration" | "method_declaration" => return Some(parent),
      _ => current = parent.Parent(),
    }
  }
}

fn fn_name(declaration: Ref<ts.Node>, source: Slice<byte>) -> string {
  declaration.ChildByFieldName("name").map_or("", |node| node.Utf8Text(source))
}

fn method_identity(declaration: Ref<ts.Node>, source: Slice<byte>) -> string {
  let receiver = declaration
    .ChildByFieldName("receiver")
    .map_or("", |node| receiver_type(node, source))
  f"{receiver}.{fn_name(declaration, source)}"
}

fn receiver_type(receiver: Ref<ts.Node>, source: Slice<byte>) -> string {
  receiver
    .NamedChild(0)
    .map_or("", |parameter| {
      parameter
        .ChildByFieldName("type")
        .map_or("", |node| trim_pointer(node.Utf8Text(source)))
    })
}

fn trim_pointer(text: string) -> string {
  if text.starts_with("*") { text.substring(1..text.length()) } else { text }
}
