import ts "go:github.com/tree-sitter/go-tree-sitter"

pub struct ExtractedCall {
  pub caller: string,
  pub callee: string,
  pub kind: string,
}

pub struct ExtractedImport {
  pub alias: string,
  pub path: string,
  pub is_go: bool,
}

pub struct ExtractedFile {
  pub path: string,
  pub declarations: Slice<string>,
  pub calls: Slice<ExtractedCall>,
  pub imports: Slice<ExtractedImport>,
}

pub interface Adapter {
  fn supports(path: string) -> bool
  fn extract(path: string, source: Slice<byte>) -> ExtractedFile
}

pub struct Capture {
  name: string,
  kind: string,
  text: string,
  start: uint,
  end: uint,
}

pub struct QueryHit {
  pub name: string,
  pub node: ts.Node,
}

pub fn matches(query: Ref<ts.Query>, root: Ref<ts.Node>, text: Slice<byte>) -> Slice<Slice<QueryHit>> {
  let cursor = ts.NewQueryCursor()
  defer cursor.Close()

  let names = query.CaptureNames()
  let mut iter = cursor.Captures(query, root, text)

  let mut out: Slice<Slice<QueryHit>> = Slice.new()
  loop {
    let (Some(captured), _) = iter.Next() else {
      break
    }
    let mut group: Slice<QueryHit> = Slice.new()
    for capture in captured.Captures {
      group = group.append(
        QueryHit { name: names[capture.Index as int], node: capture.Node },
      )
    }
    out = out.append(group)
  }
  out
}

pub fn compile(language: Ref<ts.Language>, source: string) -> Result<Ref<ts.Query>, string> {
  let (query, err) = ts.NewQuery(language, source)
  query.ok_or_else(|| f"{err.Message} at {err.Row}:{err.Column}")
}

pub fn captures(query: Ref<ts.Query>, root: Ref<ts.Node>, text: Slice<byte>) -> Slice<Capture> {
  let cursor = ts.NewQueryCursor()
  defer cursor.Close()

  let names = query.CaptureNames()
  let mut iter = cursor.Captures(query, root, text)

  let mut out: Slice<Capture> = Slice.new()
  loop {
    let (Some(captured), index) = iter.Next() else {
      break
    }
    let name = names[index as int]
    let nodes = captured.NodesForCaptureIndex(index)
    for node in nodes {
      let mut n = node
      out = out.append(
        Capture {
          name,
          kind: n.Kind(),
          text: n.Utf8Text(text),
          start: n.StartByte(),
          end: n.EndByte(),
        },
      )
    }
  }
  out
}
