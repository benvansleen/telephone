import "go:slices"
import "go:strings"

const RESET = "\x1b[0m"

const HEADER = "\x1b[1;36m"

const CONTEXT = "\x1b[1m"

const CONTEXT_LOCATION = "\x1b[2;3m"

const ADDED = "\x1b[38;5;114;48;2;25;43;34m"

const ADDED_LOCATION = "\x1b[2;3;38;5;114;48;2;25;43;34m"

const REMOVED = "\x1b[38;5;210;48;2;54;29;32m"

const REMOVED_LOCATION = "\x1b[2;3;38;5;210;48;2;54;29;32m"

pub struct Edge {
  pub caller: Symbol,
  pub callee: Symbol,
  pub kind: string,
}

pub struct Graph {
  pub decls: Symbols,
  pub edges: Slice<Edge>,
}

enum SequenceKind {
  Context,
  Added,
  Removed,
}

struct SequenceItem { kind: SequenceKind, value: string }

impl Graph {
  pub fn merge(self, other: Graph) -> Graph {
    let mut decls = self.decls.clone()
    other.decls.for_each(|declaration| if !decls.has(declaration) {
      decls.push(declaration)
    })
    let mut edges = self.edges.clone()
    for edge in other.edges {
      let exists = edges
        .find(|current| {
          current.caller.equals(edge.caller) &&
          current.callee.equals(edge.callee)
        })
        .is_some()
      if !exists { edges = edges.append(edge) }
    }
    Graph { decls, edges }
  }

  pub fn diff_trees(self, other: Graph) -> string {
    let a_callees = self.adjacency()
    let b_callees = other.adjacency()
    // Lisette currently lowers `other.decls_by_file()` as `self.declsByFile()`.
    // Pass both graphs explicitly until that compiler bug is fixed.
    let a_files = self.decls_by_file()
    let b_files = other.decls_by_file()

    let mut file_names: Slice<string> = Slice.new()
    for (file, _) in a_files {
      file_names = file_names.append(file)
    }
    for (file, _) in b_files {
      if !file_names.contains(file) { file_names = file_names.append(file) }
    }
    slices.Sort(file_names)

    let mut lines: Slice<string> = Slice.new()
    for file in file_names {
      let mut fn_lines: Slice<string> = Slice.new()
      let a_names = a_files.get(file).unwrap_or_else(|| Slice.new())
      let b_names = b_files.get(file).unwrap_or_else(|| Slice.new())

      // Sequence diffing keeps replacements adjacent to their original source position
      for item in sequence(a_names, b_names) {
        match item.kind {
          SequenceKind.Removed => fn_lines = append_function(
            fn_lines,
            "-",
            file,
            item.value,
            a_callees,
          ),
          SequenceKind.Added => fn_lines = append_function(
            fn_lines,
            "+",
            file,
            item.value,
            b_callees,
          ),
          _ => {
            let identity = Symbol.local(file, item.value).to_key()
            let ac = a_callees.get(identity).unwrap_or_else(Symbols.new)
            let bc = b_callees.get(identity).unwrap_or_else(Symbols.new)
            if calls_changed(ac, bc) {
              fn_lines = fn_lines.append(f"  {item.value}")
              fn_lines = append_call_diff(fn_lines, file, ac, bc)
            }
          },
        }
      }

      if fn_lines.length() > 0 {
        lines = lines.append(f"{file}:")
        for l in fn_lines {
          lines = lines.append(l)
        }
      }
    }
    strings.Join(lines, "\n")
  }

  pub fn diff_trees_ansi(self, other: Graph) -> string {
    let diff = self.diff_trees(other)
    if diff == "" { return "" }
    let mut styled: Slice<string> = Slice.new()
    for line in diff.split("\n") {
      styled = styled.append(style_diff_line(line))
    }
    strings.Join(styled, "\n")
  }

  fn adjacency(self) -> Map<string, Symbols> {
    let mut map: Map<string, Symbols> = Map.new()
    for e in self.edges {
      let key = e.caller.to_key()
      let mut list = map.get(key).unwrap_or_else(Symbols.new)
      if !list.has(e.callee) { list.push(e.callee) }
      map[key] = list
    }
    map
  }

  fn decls_by_file(self) -> Map<string, Slice<string>> {
    let mut map: Map<string, Slice<string>> = Map.new()
    self.decls.for_each(|d| {
      let file = d.file().unwrap_or("")
      let name = d.name
      let mut list = map.get(file).unwrap_or_else(|| Slice.new())
      if !list.contains(name) { list = list.append(name) }
      map[file] = list
    })
    map
  }

  pub fn render_tree(self) -> string {
    let callees = self.adjacency()
    let files = self.decls_by_file()

    let mut file_names: Slice<string> = Slice.new()
    for (file, _) in files {
      file_names = file_names.append(file)
    }
    slices.Sort(file_names)

    let mut lines: Slice<string> = Slice.new()
    for file in file_names {
      lines = lines.append(f"{file}:")
      let mut names = files.get(file).unwrap_or_else(|| Slice.new())
      slices.Sort(names)
      for name in names {
        lines = lines.append(f"  {name}")
        let identity = Symbol.local(file, name).to_key()
        let list = callees.get(identity).unwrap_or_else(Symbols.new)
        list.for_each(|c| {
          lines = lines.append(f"    - {format_callee(c, file)}")
        })
      }
    }
    strings.Join(lines, "\n")
  }
}

fn append_function(
  mut lines: Slice<string>,
  marker: string,
  file: string,
  name: string,
  callees_by_function: Map<string, Symbols>,
) -> Slice<string> {
  lines = lines.append(f"  {marker} {name}")
  let identity = Symbol.local(file, name).to_key()
  let callees = callees_by_function.get(identity).unwrap_or_else(Symbols.new)
  callees.reduce(lines, |acc, callee| {
    acc.append(f"      {format_callee(callee, file)}")
  })
}

fn append_call_diff(
  mut lines: Slice<string>,
  file: string,
  old: Symbols,
  new: Symbols,
) -> Slice<string> {
  // Symbols have stable identities but user-facing labels depend on the caller
  // file, so sequence the identities first and render labels afterward.
  // TODO: Emit structured diff lines if another output format needs semantics.
  for item in sequence(old.keys(), new.keys()) {
    let callee = match item.kind {
      SequenceKind.Removed => old.get_key(item.value),
      _ => new.get_key(item.value),
    }
    let prefix = match item.kind {
      SequenceKind.Removed => "    - ",
      SequenceKind.Added => "    + ",
      _ => "      ",
    }
    lines = lines.append(f"{prefix}{format_callee(callee, file)}")
  }
  lines
}

fn calls_changed(old: Symbols, new: Symbols) -> bool {
  old.find(|callee| !new.has(callee)).is_some() ||
  new.find(|callee| !old.has(callee)).is_some()
}

fn format_callee(callee: Symbol, file: string) -> string {
  // Tree-sitter preserves line breaks in fluent-call expressions. Continue
  // selectors beneath their receiver rather than using their source indentation.
  file
    |> callee.display_callee
    |> strings.ReplaceAll("\n", "\n        ")
}

fn sequence(old: Slice<string>, new: Slice<string>) -> Slice<SequenceItem> {
  if old.equals(new) {
    return old.map(|value| SequenceItem { kind: SequenceKind.Context, value })
  }

  let mut prefix = 0
  while prefix < old.length() && prefix < new.length() && old[prefix] == new[prefix] {
    prefix += 1
  }
  let mut suffix = 0
  while suffix < old.length() - prefix && suffix < new.length() - prefix && old[old.length() -
  suffix -
  1] == new[new.length() - suffix - 1] {
    suffix += 1
  }

  let mut out = old[..prefix].map(|value| SequenceItem {
    kind: SequenceKind.Context,
    value,
  })
  out = out.append(sequence_changed(
    old[prefix..old.length() - suffix],
    new[prefix..new.length() - suffix],
  )...)
  for value in old[old.length() - suffix..old.length()] {
    out = out.append(SequenceItem { kind: SequenceKind.Context, value })
  }
  out
}

fn sequence_changed(old: Slice<string>, new: Slice<string>) -> Slice<SequenceItem> {
  // Build an LCS table from the end so shared declarations/calls become stable
  // anchors. At a tie, prefer removal, producing conventional `- old` then
  // `+ new` replacement groups.
  // TODO: Consider a linear-space algorithm or cutoff for generated files.
  let mut table: Slice<Slice<int>> = Slice.new()
  for _ in 0..(old.length() + 1) {
    let mut row: Slice<int> = Slice.new()
    for _ in 0..(new.length() + 1) {
      row = row.append(0)
    }
    table = table.append(row)
  }

  for old_offset in 0..old.length() {
    let i = old.length() - old_offset - 1
    for new_offset in 0..new.length() {
      let j = new.length() - new_offset - 1
      table[i][j] = if old[i] == new[j] {
        table[i + 1][j + 1] + 1
      } else if table[i + 1][j] >= table[i][j + 1] {
        table[i + 1][j]
      } else {
        table[i][j + 1]
      }
    }
  }

  let mut out: Slice<SequenceItem> = Slice.new()
  let mut i = 0
  let mut j = 0
  while i < old.length() && j < new.length() {
    if old[i] == new[j] {
      out = out.append(
        SequenceItem { kind: SequenceKind.Context, value: old[i] },
      )
      i += 1
      j += 1
    } else if table[i + 1][j] >= table[i][j + 1] {
      out = out.append(
        SequenceItem { kind: SequenceKind.Removed, value: old[i] },
      )
      i += 1
    } else {
      out = out.append(SequenceItem { kind: SequenceKind.Added, value: new[j] })
      j += 1
    }
  }
  for index in i..old.length() {
    out = out.append(
      SequenceItem { kind: SequenceKind.Removed, value: old[index] },
    )
  }
  for index in j..new.length() {
    out = out.append(
      SequenceItem { kind: SequenceKind.Added, value: new[index] },
    )
  }
  out
}

fn style_diff_line(line: string) -> string {
  if line.ends_with(":") { return f"{HEADER}{line}{RESET}" }
  if line.starts_with("  + ") || line.starts_with("    + ") {
    return style_change(line, ADDED, ADDED_LOCATION)
  }
  if line.starts_with("  - ") || line.starts_with("    - ") {
    return style_change(line, REMOVED, REMOVED_LOCATION)
  }
  if line.starts_with("  ") && !line.starts_with("    ") {
    return style_context(line)
  }
  style_neutral(line)
}

fn style_change(line: string, style: string, location_style: string) -> string {
  let parts = line.split(" (")
  if parts.length() == 2 {
    return f"{style}{parts[0]} {location_style}({parts[1]}{RESET}"
  }
  f"{style}{line}{RESET}"
}

fn style_context(line: string) -> string {
  let parts = line.split(" (")
  if parts.length() == 2 {
    return f"{CONTEXT}{parts[0]} {CONTEXT_LOCATION}({parts[1]}{RESET}"
  }
  f"{CONTEXT}{line}{RESET}"
}

fn style_neutral(line: string) -> string {
  let parts = line.split(" (")
  if parts.length() == 2 {
    return f"{parts[0]} {CONTEXT_LOCATION}({parts[1]}{RESET}"
  }
  line
}
