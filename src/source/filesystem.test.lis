import "go:os"
import "go:path/filepath"

#[test]
fn relative_path_accepts_a_trailing_root_separator() {
  assert relative_path(
    "testdata/commits/before/",
    "testdata/commits/before/audit.go",
  ) ==
  "audit.go"
}

#[test]
fn supports_only_analyzed_languages() {
  assert supported("main.go")
  assert supported("main.lis")
  assert supported("main.py")
  assert !supported("README.md")
  assert !supported("main.js")
}

#[test]
fn commit_snapshot_reads_head_tree() {
  let root = filepath.Dir(filepath.Dir(os.Getwd().unwrap_or(".")))
  let Ok(snapshot) = commit(root, "HEAD") else {
    assert false
    return
  }
  assert snapshot.label == "HEAD"
  assert snapshot.files.length() > 0
  assert snapshot.files.all(|file| supported(file.path))
}

#[test]
fn worktree_snapshot_includes_head_files() {
  let root = filepath.Dir(filepath.Dir(os.Getwd().unwrap_or(".")))
  let Ok(snapshot) = worktree(root) else {
    assert false
    return
  }
  assert snapshot.files.any(|file| file.path == "src/main.lis")
}
