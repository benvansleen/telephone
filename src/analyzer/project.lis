import "callgraph"
import lisette_adapter "treesitter/lisette"
import "source"
import "treesitter/golang"

pub fn analyze_dir(root: string) -> Result<callgraph.Graph, error> {
  analyze_files(source.files(root)?)
}

pub fn analyze_files(files: Slice<source.File>) -> Result<callgraph.Graph, error> {
  let go = golang.analyze_files(files)?
  let lisette_graph = lisette_adapter.analyze_files(files)?
  Ok(go.merge(lisette_graph))
}

pub fn analyze_file_sets(
  old_files: Slice<source.File>,
  new_files: Slice<source.File>,
) -> (callgraph.Graph, callgraph.Graph) {
  let (old_go, new_go) = golang.analyze_file_sets(old_files, new_files)
  let (old_lisette, new_lisette) = lisette_adapter.analyze_file_sets(
    old_files,
    new_files,
  )
  (old_go.merge(old_lisette), new_go.merge(new_lisette))
}
