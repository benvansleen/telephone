import "go:fmt"
import "go:golang.org/x/term"
import "go:os"

import "analyzer"
import "callgraph"
import "source"

fn main() {
  let mut repo = "."
  let mut index = 1
  if os.Args.length() > 1 && os.Args[1] == "--repo" {
    if os.Args.length() < 3 {
      usage()
      return
    }
    repo = os.Args[2]
    index = 3
  }

  let count = os.Args.length() - index
  if count > 0 && os.Args[index] == "--paths" {
    if count != 3 {
      usage()
      return
    }
    compare_paths(os.Args[index + 1], os.Args[index + 2])
    return
  }

  match count {
    0 => compare_git(repo, "HEAD", None),
    1 => compare_git(repo, os.Args[index], None),
    2 => compare_git(repo, os.Args[index], Some(os.Args[index + 1])),
    _ => usage(),
  }
}

fn compare_git(repo: string, old_revision: string, new_revision: Option<string>) {
  let old = source.commit(repo, old_revision)
  let new = match new_revision {
    Some(revision) => source.commit(repo, revision),
    None => source.worktree(repo),
  }
  match old {
    Ok(old) => match new {
      Ok(new) => print_diff(old, new),
      Err(err) => {
        let _ = fmt.Println(f"telephone: {err.Error()}")
      },
    },
    Err(err) => {
      let _ = fmt.Println(f"telephone: {err.Error()}")
    },
  }
}

fn compare_paths(old_path: string, new_path: string) {
  match analyzer.analyze_dir(old_path) {
    Ok(old) => match analyzer.analyze_dir(new_path) {
      Ok(new) => {
        print_graph_diff(f"Call graph diff {old_path} -> {new_path}", old, new)
      },
      Err(err) => {
        let _ = fmt.Println(f"telephone: {err.Error()}")
      },
    },
    Err(err) => {
      let _ = fmt.Println(f"telephone: {err.Error()}")
    },
  }
}

fn print_diff(old: source.Snapshot, new: source.Snapshot) {
  match analyzer.analyze_files(old.files) {
    Ok(old_graph) => match analyzer.analyze_files(new.files) {
      Ok(new_graph) => {
        print_graph_diff(
          f"Call graph diff {old.label} -> {new.label}",
          old_graph,
          new_graph,
        )
      },
      Err(err) => {
        let _ = fmt.Println(f"telephone: {err.Error()}")
      },
    },
    Err(err) => {
      let _ = fmt.Println(f"telephone: {err.Error()}")
    },
  }
}

fn print_graph_diff(title: string, old: callgraph.Graph, new: callgraph.Graph) {
  let color = color_enabled()
  let _ = fmt.Println()
  if color {
    let _ = fmt.Println(f"\x1b[1;37m{title}\x1b[0m")
    let _ = fmt.Println(old.diff_trees_ansi(new))
  } else {
    let _ = fmt.Println(title)
    let _ = fmt.Println(old.diff_trees(new))
  }
}

fn color_enabled() -> bool {
  os.LookupEnv("NO_COLOR").is_none() && term.IsTerminal(os.Stdout.Fd() as int)
}

fn usage() {
  fmt.Println("usage: telephone [--repo <path>] [<old-rev> [<new-rev>]]")
  fmt.Println("       telephone [--repo <path>] --paths <old-dir> <new-dir>")
}
