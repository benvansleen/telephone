import "go:fmt"
import "go:os"

import "callgraph"

fn main() {
  let root = if os.Args.length() > 1 { os.Args[1] } else { "./testdata" }
  let other = if os.Args.length() > 2 { os.Args[2] } else { "" }
  if other.length() > 0 {
    match callgraph.analyze_dir(root) {
      Ok(a) => match callgraph.analyze_dir(other) {
        Ok(b) => {
          fmt.Println()
          fmt.Println(f"Call graph diff {root} -> {other}")
          fmt.Println(a.diff_trees(b))
        },
        Err(err) => fmt.Println(f"callgraph: {err.Error()}"),
      },
      Err(err) => fmt.Println(f"callgraph: {err.Error()}"),
    }
    return
  }
  match callgraph.analyze_dir(root) {
    Ok(graph) => {
      fmt.Println()
      fmt.Println(f"Call graph for {root}")
      fmt.Println(graph.render_tree())
    },
    Err(err) => fmt.Println(f"callgraph: {err.Error()}"),
  }
}
