import "go:github.com/telephone/ts-shim"
import "go:os"
import "go:path/filepath"
import "go:slices"
import "go:strings"
import ts "go:github.com/tree-sitter/go-tree-sitter"
import tsgo "go:github.com/telephone/tsgrammar"

struct Edge { caller: string, callee: string, kind: string }

struct Graph { decls: Slice<string>, edges: Slice<Edge> }

fn analyze(source: Slice<byte>, decls_query: string, calls_query: string) -> Graph {
  let parser = ts.NewParser()
  let language = ts.NewLanguage(tsgo.GoLanguage())
  if let Err(_) = parser.SetLanguage(language) {
    return Graph { decls: Slice.new(), edges: Slice.new() }
  }
  let Some(tree) = parser.Parse(source, tsshim.NewEmptyTree()) else {
    return Graph { decls: Slice.new(), edges: Slice.new() }
  }
  defer tree.Close()

  let mut graph = Graph { decls: Slice.new(), edges: Slice.new() }
  let mut seen: Slice<string> = Slice.new()

  if let Ok(query) = compile(language, decls_query) {
    defer query.Close()
    for group in matches(query, tree.RootNode(), source) {
      let mut name: Option<string> = None
      let mut receiver: Option<string> = None
      for hit in group {
        let mut n = hit.node
        match hit.name {
          "fn.name" => name = Some(n.Utf8Text(source)),
          "method.name" => name = Some(n.Utf8Text(source)),
          "method.receiver" => receiver = Some(trim_pointer(n.Utf8Text(source))),
          _ => (),
        }
      }
      let Some(nm) = name else {
        continue
      }
      let identity = receiver.map_or(nm, |recv| f"{recv}.{nm}")
      if !graph.decls.contains(identity) {
        graph.decls = graph.decls.append(identity)
      }
    }
  }

  if let Ok(query) = compile(language, calls_query) {
    defer query.Close()
    for group in matches(query, tree.RootNode(), source) {
      for hit in group {
        if hit.name != "callee" { continue }
        let mut n = hit.node
        let callee_kind = n.Kind()
        let callee_text = n.Utf8Text(source)
        let caller = caller_of(n, source)
        let (callee, kind) = resolve(callee_kind, callee_text, graph.decls)
        let key = f"{caller}|{kind}|{callee}"
        if seen.contains(key) { continue }
        seen = seen.append(key)
        graph.edges = graph.edges.append(Edge { caller, callee, kind })
      }
    }
  }

  graph
}

fn caller_of(start: ts.Node, source: Slice<byte>) -> string {
  let mut s = start
  let mut cur = s.Parent()
  loop {
    let Some(parent) = cur else {
      return "<global>"
    }
    let kind = parent.Kind()
    if kind == "function_declaration" { return fn_name(parent, source) }
    if kind == "method_declaration" { return method_identity(parent, source) }
    cur = parent.Parent()
  }
}

fn fn_name(decl: Ref<ts.Node>, source: Slice<byte>) -> string {
  decl.ChildByFieldName("name").map_or("", |n| n.Utf8Text(source))
}

fn method_identity(decl: Ref<ts.Node>, source: Slice<byte>) -> string {
  let recv = decl
    .ChildByFieldName("receiver")
    .map_or("", |r| receiver_type(r, source))
  f"{recv}.{fn_name(decl, source)}"
}

fn receiver_type(receiver: Ref<ts.Node>, source: Slice<byte>) -> string {
  receiver
    .NamedChild(0)
    .map_or("", |param| {
      param
        .ChildByFieldName("type")
        .map_or("", |ty| trim_pointer(ty.Utf8Text(source)))
    })
}

fn trim_pointer(t: string) -> string {
  if t.starts_with("*") { t.substring(1..t.length()) } else { t }
}

fn resolve(callee_kind: string, callee_text: string, decls: Slice<string>) -> (string, string) {
  if callee_kind == "identifier" {
    if decls.contains(callee_text) {
      (callee_text, "local")
    } else {
      (callee_text, "external")
    }
  } else {
    let field = field_name(callee_text)
    method_identity_for(field, decls).map_or_else(
      || (callee_text, "external"),
      |identity| (identity, "method"),
    )
  }
}

fn field_name(qualified: string) -> string {
  let parts = qualified.split(".")
  parts[parts.length() - 1]
}

fn method_identity_for(field: string, decls: Slice<string>) -> Option<string> {
  let mut found: Option<string> = None
  for d in decls {
    if d.ends_with(f".{field}") {
      if let Some(_) = found { return None }
      found = Some(d)
    }
  }
  found
}

fn analyze_dir(root: string) -> Result<Graph, error> {
  let dq = os.ReadFile("./queries/decls.scm")? as string
  let cq = os.ReadFile("./queries/calls.scm")? as string
  analyze_dir_with(root, dq, cq)
}

fn analyze_dir_with(root: string, dq: string, cq: string) -> Result<Graph, error> {
  let files = collect_go_files(root)

  let mut fn_index: Map<string, string> = Map.new()
  let mut method_index: Map<string, string> = Map.new()
  let mut per_files: Slice<(string, Graph)> = Slice.new()
  let mut graph = Graph { decls: Slice.new(), edges: Slice.new() }

  for path in files {
    let content = os.ReadFile(path)?
    let per = analyze(content, dq, cq)
    let rel = relpath(root, path)
    per_files = per_files.append((rel, per))
    for d in per.decls {
      let ident = f"{rel}:{d}"
      graph.decls = graph.decls.append(ident)
      if d.contains(".") {
        let mname = field_name(d)
        match method_index.get(mname) {
          Some(_) => method_index[mname] = "",
          None => method_index[mname] = ident,
        }
      } else {
        fn_index[d] = ident
      }
    }
  }

  for (rel, per) in per_files {
    for e in per.edges {
      let caller = f"{rel}:{e.caller}"
      let (callee, kind) = match e.kind {
        "local" => {
          let target = fn_index
            .get(e.callee)
            .unwrap_or_else(|| f"{rel}:{e.callee}")
          (target, "local")
        },
        "method" => (f"{rel}:{e.callee}", "method"),
        _ => resolve_external(e.callee, fn_index, method_index),
      }
      graph.edges = graph.edges.append(Edge { caller, callee, kind })
    }
  }
  Ok(graph)
}

fn resolve_external(
  callee: string,
  fn_index: Map<string, string>,
  method_index: Map<string, string>,
) -> (string, string) {
  if callee.contains(".") {
    let field = field_name(callee)
    method_index
      .get(field)
      .map_or_else(|| (callee, "external"), |identity| {
        if identity.is_empty() {
          (callee, "external")
        } else {
          (identity, "method")
        }
      })
  } else {
    fn_index
      .get(callee)
      .map_or((callee, "external"), |identity| (identity, "local"))
  }
}

fn collect_go_files(dir: string) -> Slice<string> {
  let entries = os.ReadDir(dir).ok().unwrap_or_else(|| Slice.new())
  let mut out: Slice<string> = Slice.new()
  for entry in entries {
    let name = entry.Name()
    if entry.IsDir() {
      if skip_dir(name) { continue }
      let nested = collect_go_files(filepath.Join(dir, name))
      for f in nested {
        out = out.append(f)
      }
    } else if name.ends_with(".go") && !name.starts_with(".") {
      out = out.append(filepath.Join(dir, name))
    }
  }
  out
}

fn skip_dir(name: string) -> bool {
  name == ".git" || name == "vendor" || name == "target" ||
  name == "node_modules"
}

fn relpath(root: string, path: string) -> string {
  let normalized_root = strings.TrimPrefix(root, "./")
  let normalized_path = strings.TrimPrefix(path, "./")
  if normalized_path.starts_with(normalized_root) {
    normalized_path.substring(
      (normalized_root.length() + 1)..normalized_path.length(),
    )
  } else {
    path
  }
}

fn render_graph(graph: Graph) -> string {
  strings.Join(sorted_lines(graph), "\n")
}

fn render_tree(graph: Graph) -> string {
  let callees = adjacency(graph)
  let files = decls_by_file(graph)

  let mut file_names: Slice<string> = Slice.new()
  for (file, _) in files {
    file_names = file_names.append(file)
  }
  slices.Sort(file_names)

  let mut lines: Slice<string> = Slice.new()
  for file in file_names {
    lines = lines.append(f"{file}:")
    let mut names = files.get(file).unwrap_or_else(|| Slice.new())
    slices.Sort(names)
    for name in names {
      lines = lines.append(f"  {name}")
      let identity = f"{file}:{name}"
      let list = callees.get(identity).unwrap_or_else(|| Slice.new())
      for c in list {
        lines = lines.append(f"    - {display_callee(c, file)}")
      }
    }
  }
  strings.Join(lines, "\n")
}

fn adjacency(graph: Graph) -> Map<string, Slice<string>> {
  let mut map: Map<string, Slice<string>> = Map.new()
  for e in graph.edges {
    let mut list = map.get(e.caller).unwrap_or_else(|| Slice.new())
    if !list.contains(e.callee) { list = list.append(e.callee) }
    map[e.caller] = list
  }
  map
}

fn decls_by_file(graph: Graph) -> Map<string, Slice<string>> {
  let mut map: Map<string, Slice<string>> = Map.new()
  for d in graph.decls {
    let (file, name) = split_identity(d)
    let mut list = map.get(file).unwrap_or_else(|| Slice.new())
    if !list.contains(name) { list = list.append(name) }
    map[file] = list
  }
  map
}

fn diff_trees(a: Graph, b: Graph) -> string {
  let a_callees = adjacency(a)
  let b_callees = adjacency(b)
  let a_files = decls_by_file(a)
  let b_files = decls_by_file(b)

  let mut file_names: Slice<string> = Slice.new()
  for (file, _) in a_files {
    file_names = file_names.append(file)
  }
  for (file, _) in b_files {
    if !file_names.contains(file) { file_names = file_names.append(file) }
  }
  slices.Sort(file_names)

  let mut lines: Slice<string> = Slice.new()
  for file in file_names {
    let mut fn_lines: Slice<string> = Slice.new()
    let a_names = a_files.get(file).unwrap_or_else(|| Slice.new())
    let b_names = b_files.get(file).unwrap_or_else(|| Slice.new())
    let mut names: Slice<string> = Slice.new()
    for n in a_names {
      if !names.contains(n) { names = names.append(n) }
    }
    for n in b_names {
      if !names.contains(n) { names = names.append(n) }
    }
    slices.Sort(names)

    for name in names {
      let in_a = a_names.contains(name)
      let in_b = b_names.contains(name)
      if !in_b {
        fn_lines = fn_lines.append(f"  - {name}")
      } else if !in_a {
        fn_lines = fn_lines.append(f"  + {name}")
      } else {
        let identity = f"{file}:{name}"
        let ac = a_callees.get(identity).unwrap_or_else(|| Slice.new())
        let bc = b_callees.get(identity).unwrap_or_else(|| Slice.new())
        let mut added: Slice<string> = Slice.new()
        for c in bc {
          if !ac.contains(c) {
            added = added.append(f"    + {display_callee(c, file)}")
          }
        }
        let mut removed: Slice<string> = Slice.new()
        for c in ac {
          if !bc.contains(c) {
            removed = removed.append(f"    - {display_callee(c, file)}")
          }
        }
        if added.length() > 0 || removed.length() > 0 {
          slices.Sort(added)
          slices.Sort(removed)
          fn_lines = fn_lines.append(f"  {name}")
          for l in added {
            fn_lines = fn_lines.append(l)
          }
          for l in removed {
            fn_lines = fn_lines.append(l)
          }
        }
      }
    }

    if fn_lines.length() > 0 {
      lines = lines.append(f"{file}:")
      for l in fn_lines {
        lines = lines.append(l)
      }
    }
  }
  strings.Join(lines, "\n")
}

fn display_callee(identity: string, caller_file: string) -> string {
  let parts = identity.split(":")
  if parts.length() == 1 {
    f"{identity} (external)"
  } else if parts[0] == caller_file {
    parts[1]
  } else {
    f"{parts[1]} ({parts[0]})"
  }
}

fn split_identity(identity: string) -> (string, string) {
  let parts = identity.split(":")
  if parts.length() >= 2 { (parts[0], parts[1]) } else { (identity, identity) }
}

fn diff_edges(a: Graph, b: Graph) -> string {
  let mut out: Slice<string> = Slice.new()
  let a_lines = sorted_lines(a)
  let b_lines = sorted_lines(b)
  for line in a_lines {
    if !b_lines.contains(line) { out = out.append(f"- {line}") }
  }
  for line in b_lines {
    if !a_lines.contains(line) { out = out.append(f"+ {line}") }
  }
  slices.Sort(out)
  strings.Join(out, "\n")
}

fn sorted_lines(graph: Graph) -> Slice<string> {
  let mut lines: Slice<string> = Slice.new()
  for d in graph.decls {
    lines = lines.append(f"def {d}")
  }
  for e in graph.edges {
    lines = lines.append(f"edge {e.caller} -> {e.callee} ({e.kind})")
  }
  slices.Sort(lines)
  lines
}
