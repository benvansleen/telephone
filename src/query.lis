import ts "go:github.com/tree-sitter/go-tree-sitter"

struct Capture {
  name: string,
  kind: string,
  text: string,
  start: uint,
  end: uint,
}

struct QueryHit { name: string, node: ts.Node }

fn matches(query: Ref<ts.Query>, root: Ref<ts.Node>, text: Slice<byte>) -> Slice<Slice<QueryHit>> {
  let cursor = ts.NewQueryCursor()
  defer cursor.Close()

  let names = query.CaptureNames()
  let mut iter = cursor.Captures(query, root, text)

  let mut out: Slice<Slice<QueryHit>> = Slice.new()
  loop {
    let (Some(captured), _) = iter.Next() else {
      break
    }
    let mut group: Slice<QueryHit> = Slice.new()
    for capture in captured.Captures {
      group = group.append(
        QueryHit { name: names[capture.Index as int], node: capture.Node },
      )
    }
    out = out.append(group)
  }
  out
}

fn compile(language: Ref<ts.Language>, source: string) -> Result<Ref<ts.Query>, string> {
  let (query, err) = ts.NewQuery(language, source)
  query.ok_or_else(|| f"{err.Message} at {err.Row}:{err.Column}")
}

fn captures(query: Ref<ts.Query>, root: Ref<ts.Node>, text: Slice<byte>) -> Slice<Capture> {
  let cursor = ts.NewQueryCursor()
  defer cursor.Close()

  let names = query.CaptureNames()
  let mut iter = cursor.Captures(query, root, text)

  let mut out: Slice<Capture> = Slice.new()
  loop {
    let (Some(captured), index) = iter.Next() else {
      break
    }
    let name = names[index as int]
    let nodes = captured.NodesForCaptureIndex(index)
    for node in nodes {
      let mut n = node
      out = out.append(
        Capture {
          name,
          kind: n.Kind(),
          text: n.Utf8Text(text),
          start: n.StartByte(),
          end: n.EndByte(),
        },
      )
    }
  }
  out
}
